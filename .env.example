# 复制本文件为 .env 并填写（.env 里是密钥，不要发给别人）

# 飞书开放平台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Claude API Key（console.anthropic.com → API Keys）
ANTHROPIC_API_KEY=
# 识别模型与细致度（low / medium / high，越高越慢越细）
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# 多维表格（运行 python run_setup.py bitable <链接> 自动填写）
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
BITABLE_POLL_SECONDS=20

# 拣货群 chat_id，多个用逗号分隔；留空 = 机器人所在的所有群里发图片都会识别
# （运行 python run_setup.py chats 查看）
PICK_CHAT_IDS=

# 1 = 只允许登记商品字典里的 SKU；0 = 字典外的 SKU 也能登记（会提示）
STRICT_SKU=0

# 本地网页地址。改成 0.0.0.0 可让局域网其他电脑访问（无登录保护，请谨慎）
WEB_HOST=127.0.0.1
WEB_PORT=8765

# 访问 Claude API 需要代理时填写，例如 http://127.0.0.1:7890
# HTTPS_PROXY=
